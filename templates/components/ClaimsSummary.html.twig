{% set summary = this.summary %}

<div class="claims-summary">
    <div class="small text-muted mb-2 d-flex gap-2 flex-wrap">
        <span>Subject: <span class="font-monospace">{{ this.resolvedSubjectType ?? '—' }}:{{ this.resolvedSubjectId ?? '—' }}</span></span>
        <span class="ms-auto">{{ summary|length }} predicate{{ summary|length == 1 ? '' : 's' }}</span>
    </div>

    {% if summary is empty %}
        <div class="text-muted small fst-italic">No claims available to summarize.</div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-sm small align-middle mb-0">
                <thead>
                    <tr class="text-muted">
                        <th style="width:24%">Predicate</th>
                        <th>Best value</th>
                        <th style="width:80px" class="text-end">Conf.</th>
                        <th style="width:22%">Source</th>
                    </tr>
                </thead>
                <tbody>
                    {% for predicate, row in summary %}
                        {% set isFalse = row.value is same as(false) %}
                        <tr class="{{ isFalse ? 'text-muted' : '' }}">
                            <td class="font-monospace {{ isFalse ? 'text-decoration-line-through' : '' }}">{{ predicate }}</td>
                            <td style="max-width:0;">
                                {% if isFalse %}
                                    {# false boolean — struck-through predicate is enough, no value needed #}
                                {% elseif row.value is same as(true) %}
                                    <span class="badge bg-green-lt">yes</span>
                                {% elseif row.items is defined %}
                                    <div class="d-flex flex-wrap gap-1">
                                        {% for item in row.items %}
                                            {% set value = item.value %}
                                            {% set label = value is iterable ? (value.name ?? value.term ?? value.label ?? (value|json_encode)) : value %}
                                            <span class="badge text-bg-light border" title="{{ item.source }} · {{ item.confidence }}%">
                                                {{ label }}
                                            </span>
                                        {% endfor %}
                                    </div>
                                {% elseif row.value is iterable %}
                                    <pre class="mb-0" style="white-space:pre-wrap;font-size:.72rem;max-height:180px;overflow:auto;">{{ row.value|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                                {% else %}
                                    <div class="text-break">{{ row.value }}</div>
                                {% endif %}
                                {% if row.basis and not isFalse %}
                                    <div class="text-muted mt-1" style="font-size:.72rem;">{{ row.basis }}</div>
                                {% endif %}
                            </td>
                            <td class="text-end font-monospace">
                                {% if not isFalse %}
                                    {% set c = row.confidence ?? 0 %}
                                    <span class="badge text-bg-{{ confidence_class(c) }}">{{ c }}%</span>
                                {% endif %}
                            </td>
                            <td class="font-monospace text-muted" style="font-size:.72rem;">{{ isFalse ? '' : (row.source ?? '—') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
