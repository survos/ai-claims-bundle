{% set claims = this.ocrClaims %}

{% if claims is empty %}
    <div class="p-3 text-muted small">No description yet.</div>
{% else %}
    {% for claim in claims %}
        {% set isProse = claim.predicate == 'ai:observationProse' %}
        {% set label = isProse ? 'Visual description'
            : (claim.predicate == CLAIM_PRED_HTR_TEXT ? 'Handwritten text'
            : (claim.predicate == CLAIM_PRED_PRINTED_TEXT ? 'Printed text' : 'Searchable text')) %}

        <div class="mb-2">
            <div class="d-flex justify-content-between align-items-center px-3 pt-2 pb-1">
                <span class="fw-semibold small text-muted text-uppercase" style="letter-spacing:.05em;">{{ label }}</span>
                <span class="d-flex align-items-center gap-2">
                    <span class="badge bg-secondary-lt font-monospace">{{ claim.value|length }} chars</span>
                    <span class="badge text-bg-{{ confidence_class(claim.confidence) }}">
                        {{ claim.confidence }}%
                    </span>
                </span>
            </div>

            {% if isProse %}
                <div class="px-3 pb-3" style="font-size:.95rem; line-height:1.8; white-space:pre-wrap;">{{ claim.value|trim }}</div>
            {% else %}
                {% set chunks = claim.value|trim|replace({'\r\n': '\n', '\r': '\n'})|split('\n\n') %}
                <div class="px-3 pb-3" style="max-height:400px; overflow-y:auto; font-size:.9rem; line-height:1.7;">
                    {% for chunk in chunks %}
                        {% set para = chunk|replace({'\n': ' '})|replace({'  ': ' '})|trim %}
                        {% if para %}<p class="mb-2">{{ para }}</p>{% endif %}
                    {% endfor %}
                </div>
            {% endif %}

            <div class="px-3 pb-2 small text-muted d-flex justify-content-between gap-2 border-top pt-1" style="font-size:.75rem;">
                <span class="font-monospace">{{ claim.source }}</span>
                {% if claim.basis %}<span>{{ claim.basis }}</span>{% endif %}
            </div>
        </div>
    {% endfor %}
{% endif %}
