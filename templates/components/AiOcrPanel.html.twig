{% set claims = this.ocrClaims %}

{% if claims is empty %}
    <div class="alert alert-danger small mb-0">
        No OCR claims found. Run OCR/HTR so this panel reads from the claim table.
    </div>
{% else %}
    {% for claim in claims %}
        {% set label = claim.predicate == constant('Survos\\AiClaimsBundle\\Entity\\Claim::PRED_HTR_TEXT')
            ? 'HTR'
            : (claim.predicate == constant('Survos\\AiClaimsBundle\\Entity\\Claim::PRED_PRINTED_TEXT') ? 'Printed text' : 'OCR') %}
        <div class="card mb-2">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">{{ label }}</span>
                <span class="d-flex align-items-center gap-2">
                    <span class="badge bg-secondary-lt font-monospace">{{ claim.value|length }} chars</span>
                    <span class="badge text-bg-{{ claim.confidence >= 0.8 ? 'success' : (claim.confidence >= 0.5 ? 'warning' : 'secondary') }}">
                        {{ claim.confidence|number_format(2) }}
                    </span>
                </span>
            </div>
            <div class="card-body p-0">
                <pre class="p-3 small mb-0 text-muted" style="max-height:320px;overflow-y:auto;white-space:pre-wrap;">{{ claim.value }}</pre>
            </div>
            <div class="card-footer small text-muted d-flex justify-content-between gap-2 flex-wrap py-1">
                <span class="font-monospace">{{ claim.source }}</span>
                {% if claim.basis %}<span>{{ claim.basis }}</span>{% endif %}
            </div>
        </div>
    {% endfor %}
{% endif %}
